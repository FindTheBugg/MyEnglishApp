<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="variant_text_view_style" >

        <item name="fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#888992</item>
    </style>

    <style name="succes_variant_text_view_style" >

        <item name="fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#0EAD69</item>
    </style>

    <style name="wrong_variant_text_view_style" >

        <item name="fontFamily">@font/rubik_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FA4169</item>
    </style>

    <style name="number_text_view_style" >

        <item name="android:background">@drawable/shape_rounded_variants</item>
        <item name="android:textColor">#888992</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="succes_number_text_view_style" >

        <item name="android:background">@drawable/succes_shape_rounded_variants</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="wrong_number_text_view_style" >

        <item name="android:background">@drawable/wrong_shape_rounded_variants</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="leaner_layout_style" parent="TextAppearance.AppCompat">

        <item name="android:background">@drawable/shape_rounded_containers</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="succes_leaner_layout_style" >

        <item name="android:background">@drawable/succes_shape_rounded_containers</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="wrong_leaner_layout_style" >

        <item name="android:background">@drawable/wrong_shape_rounded_containers</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

</resources>